{
  "name": "dsh-quasar-theme",
  "version": "0.1.6",
  "description": "QUASAR — a space-themed skin for DeepSeek Harness: 53 tokens over one removable override layer, no wallpaper, contrast solved against a WCAG budget rather than picked by eye.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "theme",
    "skin",
    "quasar",
    "space",
    "dsh-quasar-theme"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhatCannotBeSaid/dsh-quasar-theme.git"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh.md",
    "docs/preview-light.jpg",
    "docs/preview-dark.jpg",
    "docs/optimization-s1-s10.md",
    "src",
    "build",
    "tools/*.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "build:public": "node tools/build-client.mjs --mode public",
    "measure:resources": "node tools/measure-resources.mjs",
    "prepare": "node tools/build-client.mjs",
    "check": "node tools/build-client.mjs --check",
    "selfcheck": "node tools/selfcheck.mjs",
    "audit": "node tools/token-audit.mjs",
    "test": "node --test tools/runtime.test.mjs tools/build-contract.test.mjs tools/black-hole.test.mjs tools/dialog-arc.test.mjs tools/brand-logo.test.mjs",
    "verify": "node tools/verify.mjs",
    "verify:release": "node tools/verify.mjs --strict-evidence"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
